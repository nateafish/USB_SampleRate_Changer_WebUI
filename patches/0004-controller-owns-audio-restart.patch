diff --git a/extras/reload-audio-servers.sh b/extras/reload-audio-servers.sh
new file mode 100755
index 0000000..88eec72
--- /dev/null
+++ b/extras/reload-audio-servers.sh
@@ -0,0 +1,115 @@
+#!/system/bin/sh
+
+bluetooth_mode=""
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --bluetooth-hal)
+            shift
+            case "${1:-}" in
+                aosp | legacy | offload | sysbta)
+                    bluetooth_mode="$1"
+                    shift
+                    ;;
+                *)
+                    echo "Invalid Bluetooth HAL mode" 1>&2
+                    exit 1
+                    ;;
+            esac
+            ;;
+        -h | --help)
+            echo "Usage: ${0##*/} [--bluetooth-hal MODE]"
+            exit 0
+            ;;
+        *)
+            echo "Unsupported option: $1" 1>&2
+            exit 1
+            ;;
+    esac
+done
+
+i=0
+while [ "$i" -lt 3 ]; do
+    if [ "`getprop sys.boot_completed`" = "1" ] \
+            && [ -n "`getprop init.svc.audioserver`" ]; then
+        break
+    fi
+    i=$((i + 1))
+    sleep 1
+done
+
+if [ -z "`getprop init.svc.audioserver`" ]; then
+    echo "audioserver is not found!" 1>&2
+    exit 1
+fi
+
+AudioHALs="
+vendor.audio-hal
+audio_proxy_service
+audio-hal
+audio-hal-2-0
+vendor.audio-hal-2-0
+vendor.audio-hal-4-0-msd
+vendor.audio-hal-7-0
+"
+
+if [ -n "$bluetooth_mode" ]; then
+    # Keep audioserver stopped while the Bluetooth/audio HAL graph changes so
+    # init cannot create an intermediate audioserver instance.
+    setprop ctl.stop audioserver
+    i=0
+    while [ "$i" -lt 50 ] && [ -n "`pidof audioserver 2>/dev/null`" ]; do
+        sleep 0.1
+        i=$((i + 1))
+    done
+    if [ -n "`pidof audioserver 2>/dev/null`" ]; then
+        echo "audioserver stop failed!" 1>&2
+        exit 1
+    fi
+
+    if [ "$bluetooth_mode" = "sysbta" ]; then
+        for service_name in $AudioHALs "system.bt-audio-hal"; do
+            if [ "`getprop init.svc.${service_name}`" = "stopped" ]; then
+                start "$service_name"
+            fi
+        done
+    else
+        for service_name in $AudioHALs "system.bt-audio-hal"; do
+            if [ "`getprop init.svc.${service_name}`" = "running" ]; then
+                stop "$service_name"
+            fi
+        done
+        for service_name in $AudioHALs; do
+            if [ "`getprop init.svc.${service_name}`" = "stopped" ]; then
+                start "$service_name"
+            fi
+        done
+    fi
+    setprop ctl.start audioserver
+else
+    setprop ctl.restart audioserver
+    sleep 0.2
+    if [ "`getprop init.svc.audioserver`" != "running" ] \
+            || [ -z "`pidof audioserver 2>/dev/null`" ]; then
+        pid="`getprop init.svc_debug_pid.audioserver`"
+        if [ -n "$pid" ]; then
+            kill -HUP "$pid" 1>"/dev/null" 2>&1
+        fi
+    fi
+fi
+
+i=0
+while [ "$i" -lt 50 ]; do
+    sleep 0.2
+    if [ "`getprop init.svc.audioserver`" = "running" ] \
+            && [ -n "`pidof audioserver 2>/dev/null`" ]; then
+        break
+    fi
+    i=$((i + 1))
+done
+if [ "$i" -ge 50 ]; then
+    echo "audioserver reload failed!" 1>&2
+    exit 1
+fi
+
+echo "audioserver reload complete"
+exit 0
